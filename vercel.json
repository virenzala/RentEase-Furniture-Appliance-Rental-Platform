{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/products/([^/]+)",
      "dest": "/frontend/products/[id]"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
