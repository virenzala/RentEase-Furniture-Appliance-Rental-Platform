# RentEase Backend Environment Configuration Template
# Copy this file to .env and fill in the values

# Express Port (defaults to 5000)
PORT=5000

# JSON Web Token Secret (recommended to change in production)
JWT_SECRET=rentease_super_secret_jwt_key_2026

# MongoDB URI (Required for Vercel deployment, optional for local fallback)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/rentease?retryWrites=true&w=majority
MONGODB_URI=
