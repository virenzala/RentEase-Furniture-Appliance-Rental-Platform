# Express Port (defaults to 5000)
PORT=5000

# JSON Web Token Secret
JWT_SECRET=rentease_super_secret_jwt_key_2026

# Supabase PostgreSQL Connection URL (Pg Pool)
DATABASE_URL=postgresql://postgres.<project-id>:<password>@<host>:5432/postgres

# Supabase Credentials
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxx
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxx
SUPABASE_JWKS_URL=https://<project-id>.supabase.co/auth/v1/.well-known/jwks.json

# SMTP Transactional Email Credentials (optional, defaults to Ethereal Sandbox if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RentEase" <noreply@rentease.com>
